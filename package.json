{
  "name": "@blackie360/luma-events-mcp",
  "version": "0.5.1",
  "description": "MCP server and Codex/Cursor plugin for safely managing Luma events, guests, tickets, and hosts.",
  "type": "module",
  "bin": {
    "luma-events-mcp": "./dist/index.js"
  },
  "files": [
    ".codex-plugin/",
    ".cursor-plugin/",
    ".env.example",
    ".mcp.json",
    "dist/index.d.ts",
    "dist/index.js",
    "LICENSE",
    "mcp.json",
    "README.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json && esbuild src/index.ts --bundle --platform=node --format=esm --target=node20 --sourcemap --outfile=dist/index.js",
    "check": "tsc -p tsconfig.json --noEmit",
    "prepack": "pnpm check && pnpm test",
    "test": "pnpm build && node --test dist/*.test.js",
    "start": "node dist/index.js"
  },
  "engines": {
    "node": ">=20"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Blackie360/luma-events-mcp.git"
  },
  "homepage": "https://github.com/Blackie360/luma-events-mcp#readme",
  "bugs": {
    "url": "https://github.com/Blackie360/luma-events-mcp/issues"
  },
  "keywords": [
    "mcp",
    "luma",
    "events",
    "codex",
    "cursor"
  ],
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "devDependencies": {
    "@modelcontextprotocol/sdk": "^1.17.0",
    "@types/node": "^24.0.0",
    "esbuild": "^0.25.6",
    "typescript": "^5.8.0",
    "zod": "^3.25.0"
  },
  "packageManager": "pnpm@10.13.1"
}
